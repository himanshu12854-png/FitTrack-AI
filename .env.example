NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Application Public Canonical URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
